# Copy to .env.local and fill in. NEVER commit .env.local — it is gitignored.
# NEVER paste any of these values into a chat, an issue, or a commit message.

# --- Sanity ---------------------------------------------------------------
# From sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Write token (starts with "sk"). Server-side only.
# Never prefix with NEXT_PUBLIC_ — that would ship it to every visitor's browser.
# Rotate immediately if it is ever exposed.
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook that revalidates the site.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value as an "x-revalidate-secret" header on the Sanity webhook.
# Server-side only — never prefix with NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=

# --- Lead notification email ---------------------------------------------
# From resend.com → API Keys
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# Optional sender override. Defaults to "EM8 Website <website@em-8.com>", which only
# works once em-8.com is verified in Resend. Set to onboarding@resend.dev to prove the
# path before touching DNS — Resend sandbox sends only to the account owner address.
RESEND_FROM=hunter@em-8.com

# --- Deployment -----------------------------------------------------------
# Set these in Railway's Variables tab, not in a file.
#
# Railway is connected to the GitHub repo, but it does NOT deploy on a merge to
# main — a merge leaves the site on the previous commit indefinitely. Corrected
# on 2026-09-17: PR #48 merged at 16:28 and no deployment existed for it until
# one was asked for by hand. The deploy has to be triggered, and that needs
# RAILWAY_API_TOKEN (a *project* token — see docs/deploys-and-migrations.md).
#
# RAILWAY_API_TOKEN belongs in your local .env.local and nowhere near the repo.
# It is deliberately not listed as a key below, because unlike every other
# variable here it is not read by the app at all.

# Absolute origin used by sitemap.xml, robots.txt, and canonical URLs.
# Set to https://em-8.com at cutover. Falls back to the Railway domain, then em-8.com.
NEXT_PUBLIC_SITE_URL=

# Read token. Only required once the Sanity dataset is switched from public to
# private (see the C1 finding in the plan revisions). Server-side only.
SANITY_API_READ_TOKEN=

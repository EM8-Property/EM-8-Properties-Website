# Copy to .env.local and fill in. NEVER commit .env.local — it is gitignored.
# NEVER paste any of these values into a chat, an issue, or a commit message.

# --- Sanity ---------------------------------------------------------------
# From sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Write token (starts with "sk"). Server-side only.
# Never prefix with NEXT_PUBLIC_ — that would ship it to every visitor's browser.
# Rotate immediately if it is ever exposed.
#
# On Railway it MUST have the Editor role: it creates a `lead` document for every form
# submission. A Viewer token makes every submission fail with 403 "permission create
# required", which is how production ran until 2026-10-01 with every check green. The
# main checkout's .env.local holds a Viewer token ("Claude (Robot)"). Never copy it to Railway.
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook that revalidates the site.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value as an "x-revalidate-secret" header on the Sanity webhook.
# Server-side only — never prefix with NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=

# --- Lead notification email ---------------------------------------------
# From resend.com → API Keys
RESEND_API_KEY=
# Where lead notifications go. While RESEND_FROM is the sandbox sender below, this MUST be
# the address that owns the Resend account, or Resend refuses every send and leads are
# saved with emailed: false and nobody is told.
LEAD_NOTIFICATION_EMAIL=

# Optional sender override. Defaults to "EM8 Website <website@em-8.com>", which only
# works once em-8.com is verified in Resend — and that needs DNS records the domain's Wix
# account controls (see docs/handover-2026-10-01-netlify-proxy-cutover.md). Until then
# production uses Resend's sandbox sender, which sends only to the account owner. Unquoted
# on purpose: pasted with quotes into Railway's single-value editor, the quotes become part
# of the address, Resend rejects it, and every lead is saved with emailed: false.
RESEND_FROM=EM8 Website <onboarding@resend.dev>

# --- Deployment -----------------------------------------------------------
# Set these in Railway's Variables tab, not in a file.
#
# Railway is connected to the GitHub repo, but it does NOT deploy on a merge to
# main — a merge leaves the site on the previous commit indefinitely. Corrected
# on 2026-09-17: PR #48 merged at 16:28 and no deployment existed for it until
# one was asked for by hand. The deploy has to be triggered, and that needs
# RAILWAY_API_TOKEN (a *project* token — see docs/deploys-and-migrations.md).
#
# RAILWAY_API_TOKEN belongs in your local .env.local and nowhere near the repo.
# It is deliberately not listed as a key below, because unlike every other
# variable here it is not read by the app at all.

# Absolute origin used by sitemap.xml, robots.txt, and canonical URLs.
# Production is https://em-8.com (since 2026-10-01). Inlined at BUILD time, so a change
# needs a redeploy. Unset, it falls back to the Railway domain, then em-8.com.
NEXT_PUBLIC_SITE_URL=

# Read token. Only required once the Sanity dataset is switched from public to
# private (see the C1 finding in the plan revisions). Server-side only.
SANITY_API_READ_TOKEN=
